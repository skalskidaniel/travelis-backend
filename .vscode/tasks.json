{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Pytest: Unit Tests",
      "type": "shell",
      "command": "uv run pytest",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Pytest: Integration Tests",
      "type": "shell",
      "command": "uv run pytest",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src",
          "RUN_INTEGRATION_TESTS": "1"
        }
      },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
